{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-dictate.dev/contracts/daemon-message.schema.json",
  "title": "Open Dictate daemon request",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd", "wav"],
      "properties": {
        "cmd": {"const": "transcribe"},
        "wav": {"type": "string", "minLength": 1},
        "punct": {"enum": ["raw", "smart_zh", "llm_zh"], "default": "smart_zh"},
        "tag": {"type": "string", "maxLength": 40, "description": "daemon ≥0.7.0: copied into the local log row (marks test/replay utterances)"},
        "fillers": {"enum": ["keep", "strip"], "default": "keep", "description": "daemon ≥0.8.0: strip removes the hesitation sounds 呃／嗯 after punctuation (raw keeps them)"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd"],
      "properties": {"cmd": {"enum": ["ping", "reload_lexicon", "stats"]}}
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd", "wrong", "right"],
      "properties": {
        "cmd": {"const": "add_pair"},
        "wrong": {"type": "string", "minLength": 1},
        "right": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1, "default": "dictate-ui"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd", "mode"],
      "description": "daemon ≥0.7.0, ASR_BACKEND=router: switch recognition mode without restarting",
      "properties": {
        "cmd": {"const": "set_mode"},
        "mode": {"enum": ["fast", "accurate", "快", "準"]}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd", "uid"],
      "description": "daemon ≥0.9.0, ASR_BACKEND=router: recognise a recent sentence again in another mode (default accurate); its recording is kept for recent_audio_s seconds",
      "properties": {
        "cmd": {"const": "retranscribe"},
        "uid": {"type": "string", "pattern": "^[0-9a-f]{6,32}$", "description": "uid from that sentence's transcribe response"},
        "mode": {"enum": ["fast", "accurate", "快", "準"], "default": "accurate"},
        "punct": {"enum": ["raw", "smart_zh", "llm_zh"], "default": "smart_zh"},
        "fillers": {"enum": ["keep", "strip"], "default": "keep"},
        "tag": {"type": "string", "maxLength": 40}
      }
    }
  ]
}
