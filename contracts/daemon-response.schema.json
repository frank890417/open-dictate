{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-dictate.dev/contracts/daemon-response.schema.json",
  "title": "Open Dictate daemon response",
  "type": "object",
  "required": ["ok"],
  "properties": {
    "ok": {"type": "boolean"},
    "error": {"enum": ["no_speech", "file_not_found", "asr_failed", "bad_request", "unknown_cmd", "add_pair_failed"]},
    "text": {"type": "string"},
    "raw": {"type": "string"},
    "changes": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [{"type": "string"}, {"type": "string"}],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "punct": {"enum": ["raw", "smart_zh", "llm_zh", "llm_zh_partial", "smart_zh_fallback", "asr_zh"]},
    "asr_where": {"enum": ["studio", "local"], "description": "transcribe (daemon ≥0.7.0, ASR_BACKEND=router): which path recognised this utterance"},
    "asr": {"type": "object", "description": "ping only (daemon ≥0.7.0, ASR_BACKEND=router): main/shadow model, remote and local worker status"},
    "mode": {"enum": ["fast", "accurate", null], "description": "ping / set_mode (daemon ≥0.7.0, router): current recognition mode"},
    "shadow": {"type": ["string", "null"], "description": "set_mode (daemon ≥0.7.0): shadow model after the switch"},
    "asr_ms": {"type": "integer", "minimum": 0},
    "total_ms": {"type": "integer", "minimum": 0},
    "pre_asr_ms": {"type": "integer", "minimum": 0},
    "load_ms": {"type": "integer", "minimum": 0},
    "lex_ms": {"type": "integer", "minimum": 0},
    "punct_ms": {"type": "integer", "minimum": 0},
    "pong": {"type": "boolean"},
    "model": {"type": "string"},
    "warm": {"type": "boolean"},
    "version": {"type": "string"},
    "punct_llm": {
      "type": "object",
      "description": "ping only (daemon ≥0.6.0): LLM punctuation warm-keeper status",
      "properties": {
        "enabled": {"type": "boolean"},
        "policy": {"enum": ["auto", "eager", "off"], "description": "daemon ≥0.7.2: auto = warm only when an LLM-punctuation sentence needs the model"},
        "wanted": {"type": "boolean", "description": "daemon ≥0.7.2: the keeper is currently asked to keep the model warm"},
        "loading": {"type": "boolean"},
        "ready_age_s": {"type": ["number", "null"]},
        "last_load_s": {"type": ["number", "null"]},
        "last_error": {"type": ["string", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"ok": {"const": false}}, "required": ["ok"]},
      "then": {"required": ["error"]}
    }
  ]
}
